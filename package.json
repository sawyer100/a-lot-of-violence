{
  "name": "script-modules-site",
  "private": true,
  "version": "1.0.0",
  "description": "Installation website for the JanitorAI script modules in this repository.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:dialogue": "node --test tests/dialogue-modules.test.mjs",
    "test:aftermath": "node --test tests/scene-aftermath.test.mjs",
    "test:ripper": "node --test tests/ripper.test.mjs",
    "rip": "node tools/ripper/cli.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
